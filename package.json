{
  "name": "codex-monitor",
  "version": "1.0.0-alpha.1",
  "private": true,
  "description": "Local-first monitor wrapper for the official OpenAI Codex CLI.",
  "type": "module",
  "bin": {
    "codexm": "./src/cli/codexm.js"
  },
  "engines": {
    "node": ">=20 <27"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "0.14.1"
  },
  "scripts": {
    "check": "node ./scripts/check-syntax.mjs",
    "test": "node --test",
    "test:phase1": "node --test",
    "test:phase2": "node --test test/unit/phase2-parsers.test.js",
    "test:phase3": "node --test test/unit/phase3-demand.test.js test/unit/phase3-scheduler.test.js test/unit/phase3-renderer.test.js test/unit/phase3-ring-buffer.test.js test/integration/phase3-demand-scheduler.test.js",
    "verify:phase1": "node ./scripts/phase1-auto-verify.mjs",
    "verify:phase2": "node ./scripts/phase2-auto-verify.mjs",
    "verify:phase3": "node ./scripts/phase3-auto-verify.mjs",
    "dev": "node ./src/cli/codexm.js"
  },
  "license": "MIT"
}
